function runningSum(nums) {
  const result = [];
  let sum = 0;

  for (const n of nums) {
    sum += n;
    result.push(sum);
  }

  return result;
}

const tests = [
  { input: [1, 2, 3, 4], expected: [1, 3, 6, 10] },
  { input: [1, 1, 1, 1, 1], expected: [1, 2, 3, 4, 5] },
  { input: [3, 1, 2, 10, 1], expected: [3, 4, 6, 16, 17] },
];

tests.forEach(({ input, expected }, i) => {
  const output = runningSum(input);
  const passed = JSON.stringify(output) === JSON.stringify(expected);
  console.log(
    `Example ${i + 1}: input=[${input}] output=[${output}] expected=[${expected}] ${passed ? "PASS" : "FAIL"}`
  );
});

module.exports = runningSum;
